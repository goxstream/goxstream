# ==============================================================================
# GoxStream Environment Variables Configuration (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# Database Connection Type
# Options: "d1" (default Cloudflare D1) | "postgres" (PostgreSQL)
DB_CONNECTION=d1

# Connection string for PostgreSQL (Self-hosting Node.js / VPS)
# When set, GoxStream automatically overrides D1 and connects to PostgreSQL
# DB_URL=postgres://postgres:password@localhost:5432/goxstream
