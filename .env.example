# ==============================================================================
# GoxStream Environment Variables Configuration (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# Database Connection Type
# Options: "d1" (default Cloudflare D1) | "postgres" (PostgreSQL) | "hyperdrive" (Cloudflare Hyperdrive - Workers Runtime only)
DB_CONNECTION=d1

# Connection string for PostgreSQL (Self-hosting Node.js / Docker / VPS)
# When set, GoxStream automatically overrides D1 and connects to PostgreSQL
# DB_URL=postgres://postgres:password@goxstream-postgres:5432/goxstream

# Docker Compose PostgreSQL credentials
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=goxstream

# ==============================================================================
# Cache Connection Configuration
# ==============================================================================
# Cache Connection Type
# Options: "kv" (default Cloudflare KV) | "redis" (Redis / In-Memory)
CACHE_CONNECTION=kv

# Connection string or host for Redis (Self-hosting Node.js / Docker / VPS)
# When set, GoxStream automatically overrides Cloudflare KV and connects to Redis
# REDIS_URL=redis://goxstream-redis:6379
# REDIS_HOST=goxstream-redis

# ==============================================================================
# Storage Connection Configuration (Object Storage / Video Streams / Subtitles)
# ==============================================================================
# Storage Connection Type
# Options: "r2" (default Cloudflare R2 / Miniflare) | "s3" (AWS S3 / S3-Compatible / Local Buffer)
STORAGE_CONNECTION=r2

# S3-Compatible API Credentials & Endpoint Configuration (Self-hosting Node.js / VPS / AWS / MinIO / Wasabi)
# When any of these credentials are set, GoxStream automatically overrides Cloudflare R2 and connects to S3
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET_NAME=goxstream-media-bucket
# S3_PUBLIC_URL=https://cdn.goxstream.com

# ==============================================================================
# AniList Scraper & Seeder Configuration
# ==============================================================================
# AniList API Token (Optional)
# - When set: Enables authenticated requests with higher API rate limits.
# - When omitted: Automatically falls back to public rate-limited access mode.
# ANILIST_API_TOKEN=your_anilist_bearer_token_here

# Bulk Scrape Limit (Optional, Default: 200)
# Specifies the maximum number of anime entries to scrape when running "pnpm db:seed:all"
# SCRAPE_LIMIT=200

# ==============================================================================
# AI Release Notes Generator Configuration
# ==============================================================================
# Gemini API Key used by GitHub Actions & local scripts to generate release notes
# GEMINI_API_KEY=your_gemini_api_key_here

