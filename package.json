{
  "name": "goxstream",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@goxstream/api",
    "dev:next": "turbo dev --filter=@goxstream/next",
    "dev:rr": "turbo dev --filter=@goxstream/react-router",
    "build": "turbo build",
    "build:api": "turbo build --filter=@goxstream/api",
    "build:next": "turbo build --filter=@goxstream/next",
    "build:next:cf": "turbo build:cf --filter=@goxstream/next",
    "build:rr": "turbo build --filter=@goxstream/react-router",
    "deploy:api": "pnpm --filter @goxstream/api run deploy",
    "deploy:next:cf": "turbo deploy:cf --filter=@goxstream/next",
    "deploy:rr:only": "pnpm --filter=@goxstream/react-router deploy:only",
    "typecheck": "turbo typecheck",
    "typecheck:api": "turbo typecheck --filter=@goxstream/api",
    "typecheck:next": "turbo typecheck --filter=@goxstream/next",
    "typecheck:rr": "turbo typecheck --filter=@goxstream/react-router",
    "lint": "turbo lint",
    "lint:api": "turbo lint --filter=@goxstream/api",
    "lint:next": "turbo lint --filter=@goxstream/next",
    "lint:rr": "turbo lint --filter=@goxstream/react-router",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "sdk:generate": "pnpm --filter=@goxstream/sdk-generator generate:ts",
    "sdk:generate:all": "pnpm --filter=@goxstream/sdk-generator generate:all",
    "sdk:generate:php": "pnpm --filter=@goxstream/sdk-generator generate:php",
    "sdk:generate:py": "pnpm --filter=@goxstream/sdk-generator generate:py",
    "sdk:generate:go": "pnpm --filter=@goxstream/sdk-generator generate:go",
    "sdk:generate:bash": "pnpm --filter=@goxstream/sdk-generator generate:bash",
    "sdk:generate:ps": "pnpm --filter=@goxstream/sdk-generator generate:ps"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "catalog:",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
