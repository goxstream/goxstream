{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goxstream-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.goxstream.dpdns.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goxstream",
      "database_id": "c7c88377-414d-4d56-a17b-d7210c47b803"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "6dce1dd3808943ae8bcb2130f1b36b9a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "goxstream"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.gox.my.id",
    "COOKIE_DOMAIN": ".gox.my.id"
  },
  "observability": {
    "enabled": true
  }
}