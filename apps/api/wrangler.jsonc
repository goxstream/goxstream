{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goxstream-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goxstream",
      "database_id": "93a28981-ac5e-4381-a3aa-18d98b9bf5ca"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "6ff3ff4ae7d54091910f3a6d3fb34f0c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "goxstream"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "BETTER_AUTH_SECRET": "goxstream-secret-key-development-min-32-chars!",
    "NODE_ENV": "development"
  },
  "observability": {
    "enabled": true
  }
}