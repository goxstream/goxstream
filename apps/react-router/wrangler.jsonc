{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shionstream-react-router",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./build/client"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "goxstream.dpdns.org",
      "custom_domain": true
    },
    {
      "pattern": "www.goxstream.dpdns.org",
      "custom_domain": true
    }
  ],
  "cache": {
    "enabled": true
  }
}